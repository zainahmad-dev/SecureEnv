# Supabase project settings — dashboard > Project Settings > API

# Public: safe to expose to the browser, used by lib/supabase/client.ts and server.ts
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret: server-only, bypasses Row Level Security. Never prefix with NEXT_PUBLIC_
# and never import it into client.ts. Not used yet — reserved for the seed script
# (Phase 12) and other server-side admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
