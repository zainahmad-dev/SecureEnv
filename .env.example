# Supabase project settings — dashboard > Project Settings > API

# Public: safe to expose to the browser, used by lib/supabase/client.ts and server.ts
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret: server-only, bypasses Row Level Security. Never prefix with NEXT_PUBLIC_
# and never import it into client.ts. Used by lib/supabase/admin.ts, currently
# consumed by app/api/health's database check; also reserved for the Phase 12
# seed script and other server-side admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret: server-only. Keys the HMAC that turns an invite token into the digest
# stored in team_invites.token_hash — the plaintext token is never stored, so
# without this value no invite link can be verified. Rotating it invalidates
# every outstanding invite (existing memberships are unaffected).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INVITE_TOKEN_SECRET=your-invite-token-secret

# Secret: server-only, never stored in the database. Encrypts every per-secret
# data-encryption-key (envelope encryption — see lib/crypto/master-key.ts).
# The app refuses to start without a valid one. Losing it makes every stored
# secret permanently unrecoverable by design. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=your-32-byte-master-key-in-hex

# Secret: server-only by the same convention as SUPABASE_SERVICE_ROLE_KEY and
# MASTER_KEY above — read lazily inside a function (lib/ai/client.ts), never
# at module top level, never imported into a "use client" component. Powers
# the AI features (Phase 37+) via Groq's OpenAI-compatible REST API. Free
# tier is enough — get one at https://console.groq.com/keys. This is the
# only third-party credential this project actually requires; no secret
# variable value is ever sent to it (see lib/ai/client.ts's
# assertNoSecretLikeContent).
GROQ_API_KEY=your-groq-api-key

# Optional: overrides the default model (lib/ai/client.ts) without a code
# change, in case the hardcoded default is ever deprecated on Groq's end.
# GROQ_MODEL=llama-3.3-70b-versatile